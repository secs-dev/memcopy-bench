{
  "name": "stability",
  "scenarios": ["Memcpy", "Small", "Words64"],
  "header_sizes": [8, 16],
  "payload_sizes": [64, 512, 1500, 9000],
  "min_time": "1s",
  "env": {
    "taskset_cpus": [2],
    "governor": "performance",
    "no_turbo": true
  },
  "runs": 7,
  "warmup_runs": 1,
  "repetitions": 3,
  "cooldown_s": 2,
  "isolation": "per-benchmark",
  "seed": 1234,
  "timeout_s": 600,
  "on_trial_failure": "skip",
  "stats": {
    "percentiles": [5, 25, 50, 75, 95],
    "trim": "none",
    "ci_level": 0.95,
    "load_avg_threshold": 0.25
  }
}
